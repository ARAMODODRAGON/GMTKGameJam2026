config_version=5

[application]

config/name="GMTKGameJam2026"
run/main_scene="uid://cto3wh80pmb0w"
config/features=PackedStringArray("4.6")

[autoload]

ShipStats="*uid://cx1c80vgq2ghm"
EffectsManager="*uid://ckvrack12qtih"

[debug]

